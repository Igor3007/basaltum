mixin calculator
    section.section-calculator
        .calculator
            .calculator__card
                form(action='#' method='POST').form
                    .calculator__card_title Выберите подходящие параметры
                    .calculator__card_pre Чтобы подготовить персональное предложение с ценами и сроками производства, пожалуйста, пройдите несколько простых шагов:
                    //generation params
                    button.btn.addMoreContent Подобрать утеплители

                .moreContent
                    .moreContent__title Подходящие варианты
                    .moreContent__AddText <sup>*</sup> Стоимость справочная, итоговая будет рассчитана и названа нашими специалистами.
                    //generation variants
                    .form-personal__white-layout
                        .form-personal__label Получите персональное предложение
                        .form-personal__userdata
                            form(action='#' method='POST').form
                                .form__line
                                    .form__item
                                        .form__subitem: input(type="text" name="user-name" placeholder="ФИО" oninput="this.value = this.value.replace(/[^a-zA-Zа-яА-Я \-]/g, '')")
                                    .form__item
                                        .form__subitem: input(type="text" name="user-phone" maxlength="25" data-maska="+375(##)###-##-##" placeholder="Номер телефона *" required)
                                    .form__item
                                        .form__subitem: textarea(name="user-comment" placeholder="Дополнительная информация")
                                .form__line
                                    .form__item
                                        .form__subitem
                                            button.btn(type="submit") Оставить заявку
                                    .form__note: +checkbox('Даю согласие на обработку персональных данных согласно нашей <a href="/policy/">Политике обработки данных</a>', 'agreement', false, 'required')
                        .form-personal__info
                            h3 Свяжитесь с нами
                            p Готовы стать вашим надёжным партнёром в энергоэффективном и безопасном строительстве.
                        .form-personal__contacts
                            .item-contact
                                .item-contact__label Телефон:
                                .item-contact__link
                                    a(href='tel:+375 (29) 320-20-74') +375 (29) 320-20-74
                                    ul
                                        li: a(href='#'): +bgimage('/img/icons/icon-telegram.svg')
                                        li: a(href='#'): +bgimage('/img/icons/icon-whatsapp.svg')
                                        li: a(href='#'): +bgimage('/img/icons/icon-max.svg')
                            .item-contact
                                .item-contact__label Email:
                                .item-contact__link
                                    a(href='mailto:Sales@basaltum.by') Sales@basaltum.by

