

mixin calculator
    section.section-calculator

        .calculator
            .calculator__card
                form(action='#' method='POST').form
                    .calculator__card_title Выберите подходящие параметры
                    .calculator__card_pre Чтобы подготовить персональное предложение с ценами и сроками производства, пожалуйста, пройдите несколько простых шагов:
                    .calculator__item
                        .calculator__item_title 1: Назначение
                        .additional

                            ul.additionalCheckbox
                                li(data-tab="0"): +radio('Фасад', 'radio', 'Фасад')

                                li(data-tab="1"): +radio('Утепление', 'radio', 'Утепление')

                                li(data-tab="2"): +radio('Шупомодавление', 'radio', 'Шупомодавление')

                                li(data-tab="3"): +radio('Кровля', 'radio', 'Кровля')


                            ul.additionalContend
                                li(data-content="0")
                                    .additionalContend__box
                                        .additional__label Выберите тип фасада (для назначения «Фасады» требуется дополнительное уточнение):
                                        .additionalContend__box_check
                                            +radio('Вентилируемый', 'radio2', 'Вентилируемый')
                                            +radio('Штукатурка', 'radio2', 'Штукатурка')

                                li(data-content="1")
                                    .additionalContend__box
                                        .additional__label Выберите тип утепления (для назначения «Утепление» требуется дополнительное уточнение):
                                        .additionalContend__box_check
                                            +radio('Базальтум 1', 'radio3', 'Базальтум 1')
                                            +radio('Базальтум 2', 'radio3', 'Базальтум 2')
                                            +radio('Базальтум 3', 'radio3', 'Базальтум 3')

                                li(data-content="2")
                                li(data-content="3")


                    .calculator__item
                        .calculator__item_title 2. Дополнительные параметры
                        .additional
                            .additional__label Толщина плиты:
                            ul
                                li: +radio('50 мм', 'radioAdd', '50 мм')
                                li: +radio('100 мм', 'radioAdd', '100 мм')


                            .form__item
                                label.additional__label Количество требуемых квадратных метров:
                                input(type="text" placeholder="Введите м2")




                    button.btn.addMoreContent Подобрать утеплители


