extends ../layouts/main
 
block variables
  include ../../data/data.pug
  - const title = "БАЗАЛЬТУМ - Калькулятор"
 

block main

  include ../../blocks/components/breadcrumb/breadcrumb.pug
  include ../../blocks/modules/calculator/calculator.pug

  .container
    .page
      .page__breadcrumb
        +breadcrumb([
          'Главная',
          'Калькулятор подбора утеплителя ',
        ])

      .page__title
        h1.section-title Калькулятор подбора утеплителя 
        div.section-desc Рассчитайте необходимое количество утеплителя для вашего проекта

      .page__content
        +calculator

   
       
 
block scripts
  script(src="/js/vendor.js") 
  script(src="/js/common.js") 